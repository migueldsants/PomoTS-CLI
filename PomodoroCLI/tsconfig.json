{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "rootDir": "src",
        "outDir": "dist",

        "strict": true,

        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,

        "resolveJsonModule": true,
        "skipLibCheck": true,

        "declaration": true,
        "declarationMap": true,
        "sourceMap": true
    },
    "include": ["src"],
    "exclude": ["src/**/*.test.ts", "src/**/__tests__/**"]
}
