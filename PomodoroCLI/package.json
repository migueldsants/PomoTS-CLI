{
    "name": "pomots",
    "version": "4.0.0",
    "description": "🍅 A CLI Pomodoro Timer built with TypeScript",
    "main": "dist/index.js",
    "type": "module",
    "bin": {
        "pomots": "dist/index.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "start": "node dist/index.js",
        "lint": "eslint src/",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "keywords": [
        "pomodoro",
        "timer",
        "cli",
        "typescript",
        "productivity",
        "terminal"
    ],
    "author": "migueldsants",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/migueldsants/PomoTS.git"
    },
    "dependencies": {
        "chalk": "^5.6.2",
        "chalk-animation": "^2.0.3",
        "commander": "^13.0.0",
        "figlet": "^1.9.4",
        "inquirer": "^13.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/chalk-animation": "^1.6.3",
        "@types/figlet": "^1.7.0",
        "@types/node": "^25.0.1",
        "eslint": "^9.0.0",
        "prettier": "^3.5.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.0.0",
        "vitest": "^4.1.8"
    }
}
